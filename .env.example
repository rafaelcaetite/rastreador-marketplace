# =======================================================
# RASTREADOR DE MARKETPLACE — CONFIGURAÇÃO DE AMBIENTE
# =======================================================

# 1. Alertas via Telegram Bot (Opcional se usar apenas planilha)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# 2. Termo de Pesquisa e Filtros de Preço
SEARCH_QUERY=Macbook
MIN_PRICE=1000
MAX_PRICE=30000
REQUIRE_DELIVERY=false
INTERVAL_MINUTES=10

# 3. Marketplaces Ativos (separados por vírgula: olx, ml, shopee)
ACTIVE_SOURCES=olx,ml,shopee

# 4. Integração com Google Sheets (Opcional - gera Excel/CSV local se ausente)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=Rastreador de Marketplace

# 5. Modo de Simulação (se true, não dispara notificações reais)
DRY_RUN=false
DB_PATH=deals.db
