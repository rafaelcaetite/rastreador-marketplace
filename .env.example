# Credenciais do Telegram
# Crie um bot no Telegram falando com o @BotFather para pegar o token
TELEGRAM_BOT_TOKEN=seu_token_do_bot_aqui
# Descubra seu ID falando com o @userinfobot no Telegram
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Parâmetros de Busca e Filtro
SEARCH_QUERY=Macbook Air M2
MIN_PRICE=3000
MAX_PRICE=5000
REQUIRE_DELIVERY=true
INTERVAL_MINUTES=10

# Modo de teste (se true, apenas printa no terminal sem enviar ao Telegram)
DRY_RUN=false
DB_PATH=deals.db
